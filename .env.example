# ---- Kalshi ----
# Reads (markets, candlesticks, orderbook, trades) need NO auth.
# These are only required for GetSettlements and portfolio endpoints.
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=~/.kalshi/kalshi_private_key.pem

# ---- Database ----
# Neon pooled connection string (app reads)
DATABASE_URL=
# Neon direct connection (migrations)
DIRECT_URL=

# ---- Archive ----
BETDADDY_DATA_DIR=./data
