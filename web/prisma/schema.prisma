// Bet Daddy — Postgres (Neon) holds ENGINEERED outputs only.
// Raw play-by-play and box scores stay in Parquet and are queried with DuckDB
// (Section 6): Neon's free tier is ~0.5GB and 25 seasons of pbp will not fit.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Sport {
  nfl
  nba
}

enum MatchMethod {
  EXACT
  FALLBACK
  MANUAL
  UNRESOLVED
}

enum Tier {
  UNVALIDATED
  PROVISIONAL
  VALIDATED
}

enum RunStatus {
  ok
  pending
  error
}

// ---------------------------------------------------------------- identity
model Team {
  id       String  @id
  sport    Sport
  abbrev   String
  name     String
  conference String?
  division   String?
  venue      String?
  timezone   String?
  altitudeFt Int?
  color      String?
  color2     String?
  logoUrl    String?
  players  Player[]
  @@unique([sport, abbrev])
}

model Player {
  id          String   @id @default(cuid())
  sport       Sport
  fullName    String
  position    String?
  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id])
  gsisId      String?  @unique          // nflverse
  nbaPersonId Int?     @unique
  /// Official NFL CDN headshot. Stored raw; the app injects a Cloudinary sizing
  /// transform at render time -- the unsized originals are ~4MB PNGs.
  headshotUrl String?
  /// Depth-chart standing from the latest nflverse snapshot.
  depthPos    String?
  depthRank   Int?
  /// True when the player is inside the prop-relevant depth for his position
  /// (QB1, RB1-2, WR1-3, TE1), or promoted into it by a starter's absence.
  isStarter   Boolean  @default(false)
  /// Set when this player was promoted because someone ahead of him is out.
  promotedFor String?
  externalIds Json     @default("{}")   // espn, pfr, sleeper, sportradar...
  aliases     PlayerAlias[]
  source      String
  ingestedAt  DateTime @default(now())
  @@index([sport, fullName])
}

/// Every Kalshi player key ever seen, resolved or not.
/// Section 12 says log unmatched names loudly — a queryable table beats a log line.
model PlayerAlias {
  id         String      @id @default(cuid())
  source     String                      // "kalshi"
  rawKey     String                      // "SFBPURDY13"
  team       String
  firstInit  String
  surname    String
  jerseyNum  Int?
  playerId   String?
  player     Player?     @relation(fields: [playerId], references: [id])
  method     MatchMethod
  confidence Float
  firstSeen  DateTime    @default(now())
  lastSeen   DateTime    @updatedAt
  @@unique([source, rawKey])
  @@index([playerId])
  @@index([method])                      // drives the "needs review" queue
}

// ---------------------------------------------------------------- games
model Game {
  id          String   @id
  sport       Sport
  season      Int
  week        Int?
  gameDate    DateTime
  kickoffUtc  DateTime?
  homeTeamId  String
  awayTeamId  String
  venue       String?
  roof        String?
  surface     String?
  isNeutral   Boolean  @default(false)
  /// Market-published game total and spread. Section 5.5: these drive prop volume
  /// more than anything except injuries.
  totalLine   Float?
  spreadLine  Float?
  tempF       Float?
  windMph     Float?
  homeQb      String?
  awayQb      String?
  divGame     Boolean  @default(false)
  /// Model lean from prior-season EPA ratings. RMSE on single-game margin is ~11.7
  /// points, so `leanConfident` gates whether this is worth showing as a view.
  projMargin      Float?
  leanTeam        String?
  leanConfident   Boolean @default(false)
  leanWhy         Json?
  leanDisagreement Float?
  contexts    GameContext[]
  source      String
  ingestedAt  DateTime @default(now())
  @@index([sport, season, week])
  @@index([gameDate])
}

model GameContext {
  id                  String  @id @default(cuid())
  gameId              String
  game                Game    @relation(fields: [gameId], references: [id])
  teamId              String
  daysRest            Int?
  isB2b               Boolean @default(false)
  b2bLeg              Int?
  gamesInLast4        Int?
  gamesInLast6        Int?
  travelMiles         Float?
  tzShift             Int?
  isPostBye           Boolean @default(false)
  isShortWeek         Boolean @default(false)
  altitudeFt          Int?
  windMph             Float?
  tempF               Float?
  precip              Float?
  projectedTotal      Float?
  projectedSpread     Float?
  projectedPossessions Float?
  source              String
  ingestedAt          DateTime @default(now())
  @@unique([gameId, teamId])
}

// ---------------------------------------------------------------- market archive
/// Append-only. Kalshi does NOT retain settled prop markets across seasons
/// (verified 2026-08-28: zero 2025-season prop markets reachable). Price history not
/// captured here can never be recovered, at any price.
model MarketSnapshot {
  id           BigInt   @id @default(autoincrement())
  marketTicker String
  seriesTicker String
  eventTicker  String?
  sport        Sport
  marketType   String
  ts           DateTime
  // Kalshi returns decimal strings. Money is never a float.
  yesBid       Decimal? @db.Decimal(6, 4)
  yesAsk       Decimal? @db.Decimal(6, 4)
  lastPrice    Decimal? @db.Decimal(6, 4)
  volume       Decimal? @db.Decimal(18, 4)
  openInterest Decimal? @db.Decimal(18, 4)
  strike       Float?
  status       String?
  closeTime    DateTime?
  /// precomputed because the T-60 reconstruction is the hottest backtest query
  minsToClose  Int?
  result       String?
  orderbook    Json?
  source       String
  ingestedAt   DateTime @default(now())
  @@unique([marketTicker, ts])
  @@index([marketTicker, minsToClose])
  @@index([sport, marketType, ts])
}

model MarketSettlement {
  marketTicker    String   @id
  settledTs       DateTime
  result          String
  settlementValue Decimal? @db.Decimal(18, 4)
  source          String
  ingestedAt      DateTime @default(now())
}

// ---------------------------------------------------------------- model output
model Projection {
  id           String   @id @default(cuid())
  playerId     String
  gameId       String
  marketType   String
  modelVersion String
  runTs        DateTime
  mean         Float
  stdev        Float
  distribution Json     // percentiles
  pOverByStrike Json    // strike -> P(over)
  /// point-in-time guard: no feature used here may postdate this timestamp
  featureAsOf  DateTime
  signals      Signal[]
  source       String
  ingestedAt   DateTime @default(now())
  @@index([playerId, gameId, marketType])
  @@index([runTs])
}

model Signal {
  id            String   @id @default(cuid())
  projectionId  String
  projection    Projection @relation(fields: [projectionId], references: [id])
  marketTicker  String
  runTs         DateTime
  /// "yes" or "no". compute_edge evaluates BOTH sides and keeps the better one, so
  /// modelProb is the probability of THIS side, not always P(over). Without this
  /// column the board cannot say which bet it is recommending.
  side          String   @default("yes")
  modelProb     Decimal  @db.Decimal(6, 4)
  marketProb    Decimal  @db.Decimal(6, 4)
  /// stored, not recomputed at read time, so the Why panel shows what was actually used
  feeCents      Decimal  @db.Decimal(8, 4)
  edgeCentsNet  Decimal  @db.Decimal(8, 4)
  kellyFraction Decimal  @db.Decimal(6, 4)
  tier          Tier
  /// n behind the tier. Section 2: sample size is always rendered.
  sampleN       Int
  reason        Json     // ordered named multipliers -> Why panel
  modelVersion  String
  featureAsOf   DateTime
  /// When the market closes. The board filters on this so a signal disappears the
  /// moment its game starts, instead of being served forever because it happens to
  /// be the most recent run for that ticker. Nullable: rows written before the live
  /// board existed have no close time, and a null must not be served.
  closeTime     DateTime?
  /// Timestamp of the snapshot this price came from, so the UI can show how old the
  /// quote is rather than implying it is current.
  priceAsOf     DateTime?
  /// ACTUAL KICKOFF, from the nflverse schedule.
  ///
  /// Not `closeTime`, which is Kalshi's settlement deadline and lands roughly two days
  /// LATER: New England at Seattle kicks off 2026-09-10T00:20Z and the market's close
  /// time is 2026-09-12T00:20Z. Filtering the board on close time therefore served
  /// picks for two days after the game was played, through the game itself.
  kickoff       DateTime?
  /// The market's REAL strike -- Kalshi's `floor_strike`, not the ticker suffix. They
  /// differ by 0.5 on every count market: "8+ receptions" is ticker `...-8` and
  /// settles on MORE THAN 7.5. The board used to parse the suffix, which both
  /// displayed the wrong number and broke live repricing, because `pOverByStrike` is
  /// keyed on the floor strike and no lookup for "8" ever matched "7.5".
  strike        Decimal? @db.Decimal(10, 2)
  result        SignalResult?
  source        String
  ingestedAt    DateTime @default(now())
  @@index([marketTicker, runTs])
  @@index([tier, runTs])
  @@index([closeTime])
  @@index([kickoff])
}

model SignalResult {
  signalId      String    @id
  signal        Signal    @relation(fields: [signalId], references: [id])
  closingPrice  Decimal?  @db.Decimal(6, 4)
  /// computable at close, before settlement — the primary forward-test metric
  clvCents      Decimal?  @db.Decimal(8, 4)
  settledResult String?
  pnlIfBet      Decimal?  @db.Decimal(10, 4)
  gradedTs      DateTime?
}

/// Per-player, per-game statistics. The ONLY player history the web app can see:
/// raw Parquet is gitignored and the deployed Next app has no DuckDB, so anything the
/// player page shows has to be synced here first.
/// Kept narrow on purpose — roughly 8.5k rows a season against Neon's ~0.5GB.
model PlayerGameStat {
  id             String   @id
  playerId       String
  gameId         String
  season         Int
  week           Int
  team           String
  opponent       String?
  /// Snap counts join pfr_player_id -> gsis_id through players.parquet (99.7%
  /// coverage; weekly rosters manage 65.9%), so these can be null for a player the
  /// join missed. Null means unknown, never zero.
  offenseSnaps   Int?
  offensePct     Float?
  targets        Int?
  receptions     Int?
  receivingYards Float?
  receivingTds   Int?
  airYards       Float?
  carries        Int?
  rushingYards   Float?
  rushingTds     Int?
  passingYards   Float?
  passingTds     Int?
  interceptions  Int?
  /// Shares are the actual insight — a yardage line moves with role, not with talent.
  targetShare    Float?
  airYardsShare  Float?
  carryShare     Float?
  wopr           Float?
  source         String
  ingestedAt     DateTime @default(now())
  @@unique([playerId, gameId])
  @@index([playerId, season, week])
}

/// With/without-teammate splits from features/splits.py.
/// Every row is stored INCLUDING the ones that fail their gates, with the flags intact.
/// The UI filters; it does not re-decide. That mirrors player_volume.py, which consumes
/// `significant`/`suppressed` rather than recomputing them, and it lets the page say
/// "no trustworthy split" instead of rendering a blank.
model PlayerSplit {
  id                  String   @id
  playerId            String
  teammateId          String
  team                String
  metric              String
  season              Int
  nWith               Int
  nWithout            Int
  meanWith            Float
  meanWithout         Float
  delta               Float
  ciLow               Float
  ciHigh              Float
  significant         Boolean
  suppressed          Boolean
  confoundRegularsOut Boolean  @default(false)
  source              String
  ingestedAt          DateTime @default(now())
  @@unique([playerId, teammateId, metric, season])
  @@index([playerId, significant])
}

/// Kalshi's game-market price against the sportsbook consensus nflverse already ships.
/// REFERENCE ONLY — never an edge, never a Signal. This exists to answer DECISIONS.md
/// D8's own revisit trigger ("revisit if the archive shows Kalshi pricing diverging from
/// consensus"), which was previously unmeasurable.
/// A time series, not a snapshot: the question is whether divergence PERSISTS.
model GameMarketCompare {
  id              String   @id
  gameId          String
  ts              DateTime
  /// Null when Kalshi lists the game but nobody is quoting it — the normal state well
  /// before kickoff. Stored rather than skipped so "unquoted" is distinguishable from
  /// "job did not run".
  kalshiProbHome  Float?
  vegasProbHome   Float?
  diffPts         Float?
  kalshiOverround Float?
  vegasOverround  Float?
  kalshiQuoted    Boolean  @default(false)
  source          String
  ingestedAt      DateTime @default(now())
  @@unique([gameId, ts])
  @@index([gameId, ts])
}

// ---------------------------------------------------------------- ops
/// Section 12: stale pipeline runs must surface in the UI, never serve silently.
model PipelineRun {
  id          String    @id @default(cuid())
  job         String
  startedAt   DateTime
  finishedAt  DateTime?
  status      RunStatus
  rowsWritten Int       @default(0)
  error       String?
  meta        Json?
  @@index([job, startedAt])
}
