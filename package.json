{
  "name": "bet-daddy",
  "private": true,
  "scripts": {
    "db:generate": "prisma generate --schema=web/prisma/schema.prisma",
    "db:push": "prisma db push --schema=web/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=web/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=web/prisma/schema.prisma"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "vercel": "^59.9.1"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
